<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F9F9" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid.Resources>
    <SolidColorBrush x:Key="Accent" Color="#205C61"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#203337"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#607476"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,24,0,12"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#FCFEFE"/><Setter Property="BorderBrush" Value="#DCE6E6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#203337"/><Setter Property="BorderBrush" Value="#CCDADA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Style>
    <Style TargetType="TextBox"><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="10,5"/><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Foreground" Value="#203337"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C8D8D8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="RadioButton">
      <Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="#203337"/><Setter Property="Margin" Value="0,9"/><Setter Property="Padding" Value="0,4"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><StackPanel Orientation="Horizontal" Background="Transparent"><Grid Width="22" Height="22" VerticalAlignment="Center"><Ellipse x:Name="Ring" Stroke="#82999B" StrokeThickness="1.4" Fill="Transparent"/><Ellipse x:Name="Dot" Fill="{StaticResource Accent}" Margin="6" Visibility="Collapsed"/></Grid><ContentPresenter Margin="13,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/><Setter TargetName="Ring" Property="StrokeThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Toggle" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="48" Height="26" Background="#C6D3D4" CornerRadius="13"><Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" Margin="4" HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Foreground" Value="#3A5558"/><Setter Property="Padding" Value="10,10"/><Setter Property="Margin" Value="8,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavBack" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavBack" Property="Background" Value="#DCEDEC"/><Setter Property="Foreground" Value="#164E53"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBack" Property="Background" Value="#E5F1F0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C8D8D8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MaxDropDownHeight" Value="240"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"/>
        <ContentPresenter Margin="11,0,34,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
        <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Data="M0,0 L5,5 L10,0" Width="10" Height="5" Stroke="#36585D" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#CCDADA" BorderThickness="1" CornerRadius="5" Margin="0,4,0,0" Padding="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E9F3F2"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#DDEDEB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#E9F5F3" BorderBrush="#DCEAE7" BorderThickness="0,0,1,0">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Height="14"/>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
        <RadioButton x:Name="NavSettings" AutomationProperties.Name="设置与说明" ToolTip="设置与说明" GroupName="Navigation" Style="{StaticResource Nav}"><Grid Width="20" Height="20"><Ellipse Width="12" Height="12" Stroke="#34585D" StrokeThickness="1.5"/><Ellipse Width="4" Height="4" Stroke="#34585D" StrokeThickness="1.5"/><Path Data="M10,1 L10,4 M10,16 L10,19 M1,10 L4,10 M16,10 L19,10 M3.6,3.6 L5.7,5.7 M14.3,14.3 L16.4,16.4 M3.6,16.4 L5.7,14.3 M14.3,5.7 L16.4,3.6" Stroke="#34585D" StrokeThickness="1.5"/></Grid></RadioButton>
      </StackPanel>
      <StackPanel>
        <RadioButton x:Name="NavTime" AutomationProperties.Name="时间" ToolTip="时间" GroupName="Navigation" Style="{StaticResource Nav}" IsChecked="True"><Grid Width="20" Height="20"><Ellipse Margin="1" Stroke="#34585D" StrokeThickness="1.5"/><Polyline Points="10,5 10,10 14,12" Stroke="#34585D" StrokeThickness="1.5" StrokeLineJoin="Round"/></Grid></RadioButton>
        <RadioButton x:Name="NavWallpaper" AutomationProperties.Name="壁纸" ToolTip="壁纸" GroupName="Navigation" Style="{StaticResource Nav}"><Grid Width="20" Height="20"><Rectangle Width="18" Height="15" RadiusX="1" RadiusY="1" Stroke="#34585D" StrokeThickness="1.5"/><Path Data="M2,15 L7,10 L11,14 L15,9 L18,13" Stroke="#34585D" StrokeThickness="1.3"/><Ellipse Width="3" Height="3" Fill="#34585D" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0"/></Grid></RadioButton>

      </StackPanel>
    </DockPanel>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="34,28,34,20">
        <StackPanel x:Name="TimePage">
          <TextBlock Text="时间" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="让白天与夜晚的壁纸，随太阳自动切换。" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
          <TextBlock Text="切换" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="启用自动壁纸切换"/><TextBlock Text="保存后按当前规则运行" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><CheckBox x:Name="EnabledToggle" Grid.Column="1" Style="{StaticResource Toggle}" AutomationProperties.Name="启用自动壁纸切换"/></Grid></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <RadioButton x:Name="FixedRadio" GroupName="Schedule" Content="自定义时间"/>
            <RadioButton x:Name="SystemRadio" GroupName="Schedule" Content="日出日落（系统定位）"/>
            <RadioButton x:Name="ManualRadio" GroupName="Schedule" Content="日出日落（指定坐标）"/>
          </StackPanel></Border>
          <Border x:Name="SolarCard" Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="位置" FontWeight="SemiBold"/><TextBlock x:Name="LocationInfo" Text="启动时校对系统位置；无法获取时使用下方备用坐标。" Style="{StaticResource Muted}" Margin="0,7,0,16"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="纬度" Margin="0,0,0,8" FontSize="14"/><TextBox x:Name="LatitudeInput" AutomationProperties.Name="纬度"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="经度" Margin="0,0,0,8" FontSize="14"/><TextBox x:Name="LongitudeInput" AutomationProperties.Name="经度"/></StackPanel></Grid>
            <TextBlock Text="南纬、西经使用负数；例如纬度 -36.85，经度 174.76。" Style="{StaticResource Muted}" Margin="0,10,0,14"/>
            <Button x:Name="LocationButton" Content="重新读取系统位置" HorizontalAlignment="Left"/>
          </StackPanel></Border>
          <Border x:Name="FixedCard" Style="{StaticResource Card}" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="白天开始时间" Margin="0,0,0,8" FontSize="14"/><TextBox x:Name="DayTimeInput" AutomationProperties.Name="白天开始时间"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="夜晚开始时间" Margin="0,0,0,8" FontSize="14"/><TextBox x:Name="NightTimeInput" AutomationProperties.Name="夜晚开始时间"/></StackPanel></Grid></Border>
          <StackPanel x:Name="OffsetSection"><TextBlock Text="调整" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="提前或延后切换"/><TextBlock Text="负值代表提前，正值代表延后。单位：分钟。" Style="{StaticResource Muted}" Margin="0,6,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="日出 / 白天" FontSize="14" Margin="0,0,0,8"/><TextBox x:Name="RiseOffsetInput" AutomationProperties.Name="日出偏移分钟"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="日落 / 夜晚" FontSize="14" Margin="0,0,0,8"/><TextBox x:Name="SetOffsetInput" AutomationProperties.Name="日落偏移分钟"/></StackPanel></Grid></StackPanel></Border></StackPanel>
          <TextBlock Text="今日计划" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="PreviewText" Text="填写位置后预览今日计划。" LineHeight="27"/><TextBlock x:Name="ClockText" Style="{StaticResource Muted}" Margin="0,12,0,16"/><Button x:Name="PreviewButton" Content="预览今日计划" HorizontalAlignment="Left"/></StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="WallpaperPage" Visibility="Collapsed">
          <TextBlock Text="壁纸" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="为白天与夜晚，各选择一张 Wallpaper Engine 壁纸。" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
          <TextBlock Text="Wallpaper Engine" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="EngineStatusDot" Width="11" Height="11" Fill="#819698" VerticalAlignment="Top" Margin="0,8,14,0"/>
            <StackPanel Grid.Column="1"><TextBlock x:Name="EngineStatusTitle" Text="正在自动检测 Wallpaper Engine…" FontWeight="SemiBold"/>
              <TextBlock x:Name="EngineStatusDetail" Text="优先检查已保存的位置，再自动查找安装。" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
              <Button x:Name="EngineSettingsLink" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0,6" Margin="0,6,0,0" MinHeight="28"><TextBlock Text="前往设置 → Wallpaper Engine" Foreground="{StaticResource Accent}" TextDecorations="Underline"/></Button>
            </StackPanel></Grid></Border>
          <TextBlock Text="昼夜壁纸" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="白天壁纸" FontWeight="SemiBold" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DayPathInput" AutomationProperties.Name="白天壁纸文件"/><Button x:Name="DayBrowse" Content="浏览" Grid.Column="1" Margin="10,0,0,0"/></Grid><WrapPanel Margin="0,14,0,0"><Button x:Name="DayLibrary" Content="从已安装壁纸选择" Margin="0,0,10,0"/><Button x:Name="DayTest" Content="测试白天壁纸"/></WrapPanel></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="夜晚壁纸" FontWeight="SemiBold" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NightPathInput" AutomationProperties.Name="夜晚壁纸文件"/><Button x:Name="NightBrowse" Content="浏览" Grid.Column="1" Margin="10,0,0,0"/></Grid><WrapPanel Margin="0,14,0,0"><Button x:Name="NightLibrary" Content="从已安装壁纸选择" Margin="0,0,10,0"/><Button x:Name="NightTest" Content="测试夜晚壁纸"/></WrapPanel></StackPanel></Border>
          <TextBlock Text="显示器" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Wallpaper Engine 显示器编号" Margin="0,0,0,12"/><TextBox x:Name="MonitorInput" Text="0" Width="110" HorizontalAlignment="Left" AutomationProperties.Name="显示器编号"/><TextBlock Text="0 为第一块屏幕，1 为第二块。当前版本每次管理一块屏幕。" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
          <TextBlock Text="先保存原播放列表并停用它的定时切换，避免两套规则相互覆盖。测试按钮会立即更改当前桌面。" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
          <TextBlock Text="设置与说明" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="启动、运行方式与恢复" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
          <TextBlock Text="语言" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="选择界面语言，保存后记住选择。" Style="{StaticResource Muted}" Margin="0,0,0,10"/><ComboBox x:Name="LanguageSelect" AutomationProperties.Name="语言" Width="280" HorizontalAlignment="Left"><ComboBoxItem Tag="auto" Content="跟随 Windows 系统"/><ComboBoxItem Tag="zh-CN" Content="简体中文"/><ComboBoxItem Tag="en" Content="English"/></ComboBox></StackPanel></Border>
          <TextBlock Text="Wallpaper Engine" Style="{StaticResource Section}"/><Border x:Name="EngineSettingsSection" Style="{StaticResource Card}"><StackPanel><TextBlock Text="程序位置" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="EngineInput" AutomationProperties.Name="Wallpaper Engine 程序位置"/><Button x:Name="EngineBrowse" Content="浏览" Grid.Column="1" Margin="10,0,0,0"/></Grid><Button x:Name="FindEngine" Content="重新自动检测" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
          <TextBlock Text="启动" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="登录 Windows 后启动"/><TextBlock x:Name="StartupInfo" Text="在当前用户登录后启动到托盘" Style="{StaticResource Muted}" Margin="0,5,20,0"/></StackPanel><CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource Toggle}" AutomationProperties.Name="登录 Windows 后启动"/></Grid></Border>
          <TextBlock Text="首次使用" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><TextBlock LineHeight="28" Text="1. 选择时间方式，核对位置并预览今日计划。&#10;2. 选择 Wallpaper Engine 和昼夜壁纸，分别测试。&#10;3. 保存原播放列表，停用其中的固定定时切换。&#10;4. 打开启用开关，点击“保存设置”。"/></Border>
          <TextBlock Text="运行与校对" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><TextBlock LineHeight="28" Text="日期、时间与时区始终采用 Windows 当前值。使用系统定位时，每次启动读取系统位置；有结果就直接采用，无法获取时保留坐标并提示。&#10;&#10;日出日落在本地估算。系统定位本身可能使用网络或缓存。程序每 15 秒检查一次；唤醒、解锁及 Wallpaper Engine 重启后重新对齐。关闭窗口会留在托盘，彻底退出请使用托盘菜单。"/></Border>
          <TextBlock Text="恢复与卸载" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><TextBlock LineHeight="28" Text="关闭登录启动选项并保存，从托盘彻底退出，然后在 Wallpaper Engine 中加载原播放列表。删除便携文件夹即可卸载。&#10;&#10;settings.xml 为本机设置，.bak 为上次备份；activity.log 为操作记录。坐标只保存在本机。安装模式保存到用户数据目录，便携模式保存到 data 文件夹。本程序不会修改 Windows 时钟或定位权限。"/></Border>
          <TextBlock Text="开源许可" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="HorizonSync 按 GPL-3.0-only 发布，不提供担保。"/><TextBlock Text="Copyright © 2026 fireery and HorizonSync contributors" Style="{StaticResource Muted}" Margin="0,8,0,14"/><Button x:Name="LicenseButton" Content="查看许可证" HorizontalAlignment="Left"/></StackPanel></Border>
          <TextBlock Text="HorizonSync 0.2.0-preview" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="1" Background="#F3F9F9" BorderBrush="#DCE8E7" BorderThickness="0,1,0,0" Padding="28,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="自动切换未启用" FontSize="13"/><TextBlock Text="修改后点击保存设置" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Button x:Name="HideButton" Content="隐藏到托盘" Grid.Column="1" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource Primary}" Grid.Column="2"/></Grid></Border>
  </Grid>
</Grid>
